# Copy to docker/.env; do not replace backend/.env or frontend/.env.local.
POSTGRES_DB=bolsa_practicas
POSTGRES_USER=bolsa
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_HEX_PASSWORD
# Same password as above; db is the Compose hostname (not localhost).
DATABASE_URL=postgresql://bolsa:REPLACE_WITH_A_RANDOM_HEX_PASSWORD@db:5432/bolsa_practicas
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_PORT=8080
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:8080
# Local HTTP only. Use true with HTTPS in production.
COOKIE_SECURE=false
# Keep local until S3 is available. The driver applies to all new uploads.
STORAGE_DRIVER=local
AWS_REGION=us-west-2
S3_BUCKET=
# Optional for local Docker access to S3. On AWS prefer the workload IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
ADMIN_EMAIL=admin@bolsapracticas.local
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD_MIN_12_CHARACTERS
ALLOW_DEMO_SEED=false