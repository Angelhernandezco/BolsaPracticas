DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/bolsa_practicas
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/bolsa_practicas_test
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_URL=http://localhost:8443
PORT=3001
HOST=127.0.0.1
TRUST_PROXY=false
NODE_ENV=development
# Optional COOKIE_SECURE=true/false. Default: true in production, false otherwise.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-account@gmail.com
EMAIL_PASSWORD=YOUR_APP_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD
ALLOW_DEMO_SEED=false
# S3 privado; usa la cadena estándar de credenciales AWS o un rol IAM.
AWS_REGION=us-west-2
S3_BUCKET=
# Opcional: servir el build de React desde Express con un solo origen.
SERVE_FRONTEND=false
